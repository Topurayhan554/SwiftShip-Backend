<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Password Changed - SwiftShip</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f5f7;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f4f5f7; padding: 40px 0"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="480"
            cellpadding="0"
            cellspacing="0"
            style="
              background-color: #ffffff;
              border-radius: 8px;
              overflow: hidden;
              box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
            "
          >
            <tr>
              <td style="background-color: #0f172a; padding: 24px 32px">
                <span style="color: #ffffff; font-size: 20px; font-weight: bold"
                  >SwiftShip</span
                >
              </td>
            </tr>
            <tr>
              <td style="padding: 32px">
                <h2 style="margin: 0 0 8px; color: #0f172a; font-size: 20px">
                  Your password has been changed
                </h2>
                <p
                  style="
                    margin: 0 0 24px;
                    color: #475569;
                    font-size: 14px;
                    line-height: 1.6;
                  "
                >
                  Hi <strong><%= name %></strong>, this is a confirmation that
                  the password for your account (<strong><%= email %></strong>)
                  was successfully changed on
                  <strong><%= changeDate %></strong>.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        padding: 20px;
                        background-color: #f1f5f9;
                        border-radius: 8px;
                      "
                    >
                      <span
                        style="
                          font-size: 32px;
                          line-height: 1;
                          display: inline-block;
                          margin-bottom: 8px;
                        "
                        >&#10003;</span
                      >
                      <p
                        style="
                          margin: 0;
                          color: #0f172a;
                          font-size: 15px;
                          font-weight: bold;
                        "
                      >
                        Password updated successfully
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 24px 0 0;
                    color: #64748b;
                    font-size: 13px;
                    line-height: 1.6;
                  "
                >
                  If you made this change, no further action is needed. If you
                  did <strong>not</strong> request this change, please
                  <a
                    href="<%= supportLink %>"
                    style="color: #2563eb; text-decoration: none"
                    >contact our support team</a
                  >
                  immediately to secure your account.
                </p>
              </td>
            </tr>
            <tr>
              <td
                style="
                  padding: 20px 32px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e2e8f0;
                "
              >
                <p style="margin: 0; color: #94a3b8; font-size: 12px">
                  &copy; <%= new Date().getFullYear() %> SwiftShip. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
